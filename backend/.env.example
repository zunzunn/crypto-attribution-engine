# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=crypto-attribution-engine
APP_ENV=dev
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# JSON list of allowed origins for the (not-yet-built) React dashboard.
CORS_ORIGINS=["http://localhost:5173"]

# Create tables on startup (dev convenience). Set to false in production and
# use Alembic migrations instead.
DB_AUTO_CREATE=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy async URL. For a local Homebrew PostgreSQL without a password this
# usually works as-is (adjust the user):
#   postgresql+asyncpg://<your_user>@localhost:5432/crypto_attribution
# For the Docker Compose service (see compose.yaml):
#   postgresql+asyncpg://crypto:crypto@localhost:5432/crypto_attribution
DATABASE_URL=postgresql+asyncpg://shouryasinha@localhost:5432/crypto_attribution

# Used by the automated test suite. Tests fall back to in-memory SQLite when
# this is empty, but PostgreSQL is the recommended target.
TEST_DATABASE_URL=postgresql+asyncpg://POSTGRES_USER@localhost:5432/crypto_attribution_test

# ---------------------------------------------------------------------------
# Ethereum (Etherscan)
# ---------------------------------------------------------------------------
# Etherscan API key. CREATE ONE at https://etherscan.io/apis and put it here.
# The project never commits, logs, or hardcodes this value. Without a valid
# key the provider returns a clear "Missing/Invalid API Key" error.
ETHERSCAN_API_KEY=

# Network/chain. Supported: mainnet (1), sepolia (11155111).
# The V2 Etherscan endpoint addresses many EVM chains via `chainid`.
ETHERSCAN_NETWORK=mainnet

# Override only if you need a different Etherscan-compatible endpoint.
# Default: https://api.etherscan.io/v2/api
# ETHERSCAN_BASE_URL=

# Optional explicit chain id override (Integer). Defaults to a built-in map
# for `mainnet` / `sepolia`.
# ETHERSCAN_CHAIN_ID=

ETHERSCAN_TIMEOUT_SECONDS=30
ETHERSCAN_PAGE_SIZE=1000
ETHERSCAN_MAX_PAGES=20